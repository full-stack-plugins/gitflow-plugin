{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "gitflow",
  "version": "0.3.0",
  "description": "Nine Git skills plus deterministic gates: initialization, branch roles, commit policy, sync, release backports, recovery and audit.",
  "author": {
    "name": "Full Stack Skills"
  },
  "license": "Apache-2.0",
  "keywords": [
    "git",
    "gitflow",
    "branch",
    "workflow"
  ],
  "extensions": {
    "org.fullstackskills.gitflow": {
      "policySchema": "2.0.0",
      "skillsLock": "./skills.lock.json",
      "claudeManifest": "./.claude-plugin/plugin.json",
      "codexManifest": "./.codex-plugin/plugin.json",
      "zcodeManifest": "./.zcode-plugin/plugin.json",
      "hooks": "./hooks/hooks.json"
    },
    "com.openai": {
      "interface": {
        "displayName": "Git Branch Governance · GitFlow",
        "shortDescription": "Branch naming, creation, commits, sync and release backports",
        "defaultPrompt": [
          "识别本项目 Git 规范并执行只读审计",
          "预览符合项目工作流的任务分支"
        ],
        "brandColor": "#F05032",
        "logo": "./assets/logo.png",
        "logoDark": "./assets/logo.png",
        "composerIcon": "./assets/logo.png",
        "composerIconDark": "./assets/logo.png"
      }
    }
  },
  "repository": "https://github.com/full-stack-plugins/gitflow-plugin",
  "homepage": "https://github.com/full-stack-plugins/gitflow-plugin"
}
